# No hace falta copiar este archivo a mano: `npm run configurar` crea el .env
# por vos. Queda acá como referencia de qué variables usa el CRM.

# --- Servidor ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_KEY=TU_CLAVE_SECRETA
PORT=3001
# Carpeta para las sesiones de WhatsApp (en el servidor, fuera del código).
AUTH_DIR=

# --- Navegador ---
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_PUBLICA
VITE_BACKEND_URL=http://localhost:3001
